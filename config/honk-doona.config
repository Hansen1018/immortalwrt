# Seed configuration for a honk + doona build.
#
#   cp config/honk-doona.config .config
#   make defconfig
#
# Add the target and the device to the same file before running "make defconfig",
# e.g.
#
#   CONFIG_TARGET_rockchip=y
#   CONFIG_TARGET_rockchip_armv8=y
#   CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y
#
# honk is a CO-RE eBPF program and needs a kernel with BTF. The tree builds a BTF
# kernel by default on every target that can run honk (see config/Config-kernel.in),
# so nothing else has to be configured.
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
