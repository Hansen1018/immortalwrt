global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    dial_mode: domain
    allow_insecure: false
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk'
    bootstrap_resolver: '127.0.0.1:53'
    store_subscribe: true
    nfqueue_enable: true
}

# 地理数据的下载源：面板（核心自带 API）与 LuCI 的 update-geo.sh 共用这一份，
# 两条路径拿到的字节相同，核心就不会重复覆盖，两边也不会互相干扰。
# route: direct —— 下载不走代理组（没配订阅时代理组是空的）；直连下载需要
# global.bootstrap_resolver 才能解析域名（没有系统 DNS 回退）。
#
# bootstrap_resolver 用路由器自己的解析器（dnsmasq），不要用公网上的 DNS：
# 订阅的 route: direct 抓取也走它，而且它的答案一旦解析出来就不再回落到系统
# 解析器（只有失败或空结果才回落）。换成公网 DNS 就等于替订阅换了 DNS，
# 被污染或劫持的域名会解析到错的地址，订阅就再也拉不到数据 —— 实测：
# 配了假 resolver 后订阅 status 变成 stale、节点为 0，而去掉它就正常。
# 本机的解析器永远可达，答案与系统解析器一致，等于升级前的行为。
assets {
    geodata {
        geosite: 'https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat'
        geoip: 'https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geoip.dat'
        route: direct
    }
}

experimental {
    native_api {
        enabled: true
        listen: '127.0.0.1:9527'
        password_auth: true
        allow_anonymous_loopback: false
        config_write: true
        ui: '/usr/share/doona'
    }
}
