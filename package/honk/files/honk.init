#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

. /lib/functions.sh

HONK_CONTROL=/usr/share/honk/control.sh
HONK_CONFIG=/etc/honk/config.dae

boot() {
	# 开机自启内置：只要服务是"已启用 + 已初始化"就起来，
	# 用户主动停掉（enabled=0）后重启也不会被强行拉起。
	start
}

start_service() {
	local enabled initialized config_file ready_token ready_hash ready_runtime ready_api_enabled ready_api_listen ready_clash_api_listen ready_clash_api_secret_set old_ready_token
	config_load honk
	config_get_bool enabled main enabled 0
	config_get_bool initialized main initialized 0
	[ "$enabled" -eq 1 ] && [ "$initialized" -eq 1 ] || {
		logger -t honk "refusing to start before explicit initialization and enablement"
		return 1
	}
	config_get config_file main config_file "$HONK_CONFIG"
	[ "$config_file" = "$HONK_CONFIG" ] || {
		logger -t honk "refusing non-default config path"
		return 1
	}
	"$HONK_CONTROL" preflight || return 1
	"$HONK_CONTROL" local-direct || logger -t honk "local-direct sync skipped"
	# 旧版本写进 system.dae 的地理数据下载源要删掉（见 control.sh migrate）：
	# 那一段把源写死成一个 GitHub 地址并强制直连，覆盖了核心自己的内置列表
	# （每个文件两个地址，一个不通就换下一个），面板的「立即更新」因此只会
	# 超时。现在核心用内置的列表，路由规则决定出口。
	# 此刻核心还没起：文件变了以后清修订是安全的，db 模式的核心下次启动
	# 才会把当前配置文件重新导入。
	if "$HONK_CONTROL" migrate 2>/dev/null | grep -qx changed; then
		"$HONK_CONTROL" sync-db >/dev/null 2>&1 || :
		logger -t honk "removed the old geodata source block; the state db will re-import the config"
	fi
	unset HONK_MAINT_CAP

	# 所有配置都走 readiness 标记：状态页据此判断真正就绪，而不是只看进程在不在。
	ready_token=$(cat /proc/sys/kernel/random/uuid 2>/dev/null) || return 1
	case "$ready_token" in *[!0-9a-f-]*|'') return 1 ;; esac
	ready_hash=$(sha256sum "$HONK_CONFIG" 2>/dev/null | awk '{print $1}') || return 1
	case "$ready_hash" in *[!0-9a-f]*|'') return 1 ;; esac
	ready_runtime=$(/usr/bin/honk-core config validate --config "$HONK_CONFIG" 2>/dev/null) || return 1
	ready_api_enabled=$(printf '%s' "$ready_runtime" | jsonfilter -e '@.runtime.native_api_enabled' 2>/dev/null)
	ready_api_listen=$(printf '%s' "$ready_runtime" | jsonfilter -e '@.runtime.native_api_listen' 2>/dev/null)
	ready_clash_api_listen=$(printf '%s' "$ready_runtime" | jsonfilter -e '@.runtime.clash_api_listen' 2>/dev/null)
	ready_clash_api_secret_set=$(printf '%s' "$ready_runtime" | jsonfilter -e '@.runtime.clash_api_secret_set' 2>/dev/null)
	case "$ready_api_enabled" in true|false) ;; *) return 1 ;; esac
	case "$ready_api_listen" in *[!A-Za-z0-9:._-]*) return 1 ;; esac
	case "$ready_clash_api_listen" in *[!A-Za-z0-9:._-]*) return 1 ;; esac
	case "$ready_clash_api_secret_set" in true|false) ;; *) return 1 ;; esac
	mkdir -p /var/run/honk || return 1
	chmod 0700 /var/run/honk || return 1
	if [ -f /var/run/honk/readiness ] && [ ! -L /var/run/honk/readiness ]; then
		read -r old_ready_token _ < /var/run/honk/readiness
		case "$old_ready_token" in ''|*[!0-9a-f-]*) ;; *) rm -f "/var/run/honk/core-ready-$old_ready_token" ;; esac
	fi
	printf '%s %s\n' "$ready_token" "$ready_hash" > /var/run/honk/readiness || return 1
	chmod 0600 /var/run/honk/readiness || return 1
	procd_open_instance main
	# 存储模式：db = 核心托管配置（原生 API 的导入/修订历史可用）；file = 配置文件为准。
	# 两种模式都需要 native-api 构建特性（--store db 按 honk 文档要求）。
	# --data-dir 必须与配置里的 global.data_dir 完全一致（honk 文档的硬性要求）。
	# 不一致时核心会直接退出（"global.data_dir ... differs from --data-dir ..."），
	# 状态库也会和 mock 核心分家：Doona 管理员与修订历史两边对不上。
	honk_data_dir=$(sed -n "s/^[[:space:]]*data_dir:[[:space:]]*'\([^']*\)'.*/\1/p" "$HONK_CONFIG" 2>/dev/null | head -1)
	[ -n "$honk_data_dir" ] || honk_data_dir=$(sed -n "s/^[[:space:]]*data_dir:[[:space:]]*'\([^']*\)'.*/\1/p" /etc/honk/system.dae 2>/dev/null | head -1)
	[ -n "$honk_data_dir" ] || honk_data_dir=/etc/honk
	# config_get 给了 option（第三个参数）时是 export 语义，不会往标准输出写东西，
	# 所以不能写成 $(config_get ...)：那样 store_mode 恒为空，核心会一直落在 file 模式。
	# file 模式下核心不发布 config_import/config_revisions（config_import.available=false），
	# Doona 面板的导入与修订历史就一直用不了。
	config_get store_mode main store db
	[ -n "$store_mode" ] || store_mode=db
	case "$store_mode" in
		db) procd_set_param command /usr/bin/honk-core --config "$HONK_CONFIG" --disable-timestamp --store db --data-dir "$honk_data_dir" ;;
		file) procd_set_param command /usr/bin/honk-core --config "$HONK_CONFIG" --disable-timestamp --data-dir "$honk_data_dir" ;;
		*) logger -t honk "unknown store mode '$store_mode', using file"; procd_set_param command /usr/bin/honk-core --config "$HONK_CONFIG" --disable-timestamp --data-dir "$honk_data_dir" ;;
	esac
	# One env call, no empty values: procd drops the whole list when a KEY has an
	# empty value, which silently stripped the readiness hash the core requires.
	# 地理数据放在数据目录里：软件包里的那份在只读分区（squashfs）里，
	# 核心更新时要原地替换它，写不进去 —— 面板的「立即更新」就是这么失败的。
	# 数据目录可写又是持久的，核心把新文件写在这里，之后原地替换。
	# 数据目录里没有（复制失败，空间不够）就退回软件包的那份：核心照样能起，
	# 只是更新替换不了。
	asset_dir=$honk_data_dir
	[ -f "$honk_data_dir/geosite.dat" ] && [ -f "$honk_data_dir/geoip.dat" ] || asset_dir=/usr/share/v2ray
	ready_env="DAE_LOCATION_ASSET=$asset_dir"
	ready_env="$ready_env HONK_READY_TOKEN=$ready_token HONK_READY_CONFIG_HASH=$ready_hash HONK_READY_API_ENABLED=$ready_api_enabled HONK_READY_CLASH_API_SECRET_SET=$ready_clash_api_secret_set"
	[ -n "$ready_api_listen" ] && ready_env="$ready_env HONK_READY_API_LISTEN=$ready_api_listen"
	[ -n "$ready_clash_api_listen" ] && ready_env="$ready_env HONK_READY_CLASH_API_LISTEN=$ready_clash_api_listen"
	# shellcheck disable=SC2086
	procd_set_param env $ready_env
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_close_instance
}

# 停服务时把状态库落盘：管理员记录写在 SQLite 的 WAL 里，落进 honk.db 本身
# 之后，掉电或固件升级把 -wal 弄丢了它才还在（面板也就不会要求新建管理员）。
stop_service() {
	/usr/share/honk/maintenance.sh checkpoint >/dev/null 2>&1 || :
}

reload_service() {
	# honk-core has no hot-reload API wired here; a reload is an explicit
	# restart so existing connections are cycled. The UI only exposes
	# restart, this exists so manual `/etc/init.d/honk reload` is defined.
	logger -t honk "reload requested, restarting (no hot-reload)"
	restart
}
