config honk 'main'
	option enabled '0'
	option boot_enabled '0'
	option initialized '0'
	option config_file '/etc/honk/config.dae'
	# db: 核心托管配置，Doona 面板的「导入」与「修订历史」可用
	# file: 以 /etc/honk/config.dae 为准（不产生修订历史）
	option store 'db'
	option listen_port '9527'
	option clash_api_enabled '0'
	option clash_api_port '9090'
	option clash_api_secret ''
	option lan_network 'lan'
	option geoip_url ''
	option geosite_url ''
	option geo_auto '0'
	option geo_auto_freq 'daily'
